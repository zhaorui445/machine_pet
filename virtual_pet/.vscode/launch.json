{
  "version": "0.2.0",
  "configurations": [{
    "name": "虚拟宠物：启动（本地 v6r5）",
    "type": "debugpy",
    "request": "launch",
    "program": "${workspaceFolder}/app.py",
    "args": ["--local-model"],
    "python": "${workspaceFolder}/../.venv/Scripts/python.exe",
    "cwd": "${workspaceFolder}",
    "console": "integratedTerminal",
    "env": { "PYTHONUTF8": "1" },
    "justMyCode": true
  }]
}
